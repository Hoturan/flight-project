# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored and must never be committed.
#
# Databricks Free Edition (AWS) — only Databricks credentials needed.

workspace_url            = "https://dbc-xxxxxxxx.cloud.databricks.com/"
workspace_path           = "/Workspace/flight-project"
databricks_client_id     = "your-databricks-sp-client-id"
databricks_client_secret = "your-databricks-sp-client-secret"
prefix                   = "flight"
catalog_name             = "flight_cat"
dlt_edition              = "advanced"
poll_interval_seconds    = 10