# ---------------------------------------------------------------------------
# Unity Catalog metastore
# Note: Unity Catalog requires a premium/enterprise tier workspace.
# If your workspace doesn't support UC, comment out all UC-related resources
# and create tables directly via Spark SQL.
# ---------------------------------------------------------------------------
resource "databricks_metastore" "this" {
  provider     = databricks.account
  name         = "${var.prefix}-metastore"
  storage_root = local.storage_root
  region       = var.region
}

# Assign metastore to the existing workspace
resource "databricks_metastore_assignment" "this" {
  provider     = databricks.workspace
  workspace_id = var.workspace_id
  metastore_id = databricks_metastore.this.metastore_id
}

# Set default catalog namespace (replaces deprecated default_catalog_name)
resource "databricks_default_namespace_setting" "this" {
  provider   = databricks.workspace
  namespace  = var.catalog_name
  depends_on = [databricks_metastore_assignment.this]
}

# Catalog
resource "databricks_catalog" "flight" {
  provider   = databricks.workspace
  name       = var.catalog_name
  comment    = "Flight project production catalog"
  depends_on = [databricks_metastore_assignment.this]
}

# Schemas
resource "databricks_schema" "schemas" {
  for_each     = toset(["bronze", "silver", "gold", "governance", "ml_features"])
  provider     = databricks.workspace
  catalog_name = databricks_catalog.flight.name
  name         = each.key
  comment      = "Medallion layer: ${each.key}"
}